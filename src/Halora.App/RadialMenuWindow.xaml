<Window x:Class="Halora.App.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halora"
        Width="360" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Opacity="0">

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.86" ScaleY="0.86" />
        </Grid.RenderTransform>

        <!-- Soft halo behind everything. -->
        <Ellipse Width="330" Height="330" Fill="{StaticResource InkBrush}" Opacity="0.55">
            <Ellipse.Effect>
                <BlurEffect Radius="18" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="HaloRing" Width="300" Height="300" StrokeThickness="1.5" Stroke="{StaticResource HaloBrush}" Opacity="0.55">
            <Ellipse.Effect>
                <DropShadowEffect Color="{StaticResource HaloStart}" BlurRadius="30" ShadowDepth="0" Opacity="0.8" />
            </Ellipse.Effect>
        </Ellipse>

        <Canvas x:Name="Ring" Width="360" Height="360" />

        <!-- Center: what was dropped, or the hovered action's description. Click to close. -->
        <Grid x:Name="Center" Width="128" Height="128" Cursor="Hand" ToolTip="Close (Esc)">
            <Ellipse Fill="{StaticResource InkBrush}" Stroke="{StaticResource HairlineBrush}" StrokeThickness="1" />
            <StackPanel VerticalAlignment="Center" Margin="14,0">
                <TextBlock x:Name="HeadText" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubText" Foreground="{StaticResource MutedTextBrush}" FontFamily="{StaticResource UiFont}"
                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="62" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
