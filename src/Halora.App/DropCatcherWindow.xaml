<Window x:Class="Halora.App.DropCatcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halora drop"
        Width="200" Height="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" Opacity="0">

    <!-- Alpha 1/255 is invisible but still counts as "hit" for Windows drag and drop. -->
    <Grid Background="#01000000">
        <Ellipse x:Name="Ring" Width="104" Height="104" StrokeThickness="2.5"
                 Stroke="{StaticResource HaloBrush}" Fill="#1A8B7CF6"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="{StaticResource HaloStart}" BlurRadius="24" ShadowDepth="0" Opacity="0.9" />
            </Ellipse.Effect>
        </Ellipse>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                Background="{StaticResource InkBrush}" CornerRadius="10" Padding="10,4"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <TextBlock x:Name="HintText" Text="Let go to open Halora" Foreground="{StaticResource TextBrush}"
                       FontFamily="{StaticResource UiFont}" FontSize="11" />
        </Border>
    </Grid>
</Window>
