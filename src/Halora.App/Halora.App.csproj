<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share type names (Application, MessageBox...). Explicit usings avoid clashes. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Halora</AssemblyName>
    <RootNamespace>Halora.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\halora.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>Halora</Product>
    <Description>Drag a file, hold Shift, let go, convert.</Description>
    <!-- Lets the project build (not run) on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The installer build uses the shared .NET runtime. Run on a newer major version when 8 isn't installed. -->
    <RollForward>Major</RollForward>
    <!-- The UI is English only; skip the translated WPF/WinForms resources (saves ~6 MB). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Halora.Core\Halora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\halora.ico" />
  </ItemGroup>

</Project>
